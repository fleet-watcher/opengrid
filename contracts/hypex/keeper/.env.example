# --- HYPEX keeper config ---

# Keeper wallet (gated to bridgeToCore / sellHypeForUsdc / buySpcxd; NO fund-withdraw power).
PRIVATE_KEY=0x...

# HyperEVM RPC + Hyperliquid Info API
RPC_URL=https://rpc.hyperliquid.xyz/evm
HL_API_URL=https://api.hyperliquid.xyz

# Deployed addresses
MANAGER_ADDRESS=0x...                                         # set after deploy
QUOTER_ADDRESS=0x03A918028f22D9E1473B7959C927AD7425A45C7C    # HyperSwap V3 Quoter v2 (launch-token→WHYPE floor)

# Spot books (Core orderbooks) + sizing
HYPE_BOOK_COIN=@107            # HYPE/USDC spot pair index 107
SPCXD_BOOK_COIN=@465          # SPCXD/USDC spot pair index 465
HYPE_SZ_DECIMALS=2            # szDecimals for HYPE
SPCXD_SZ_DECIMALS=2          # szDecimals for SPCXD
SLIPPAGE_BPS=100             # 1% tolerance on the swap floor and the IOC orders
MIN_HYPE_CORE=100000000      # don't sell below 1 HYPE (core 8-dec) — let it batch
MIN_USDC_CORE=100000000      # don't buy below 1 USDC (core 8-dec) — let it batch

# Fill polling + loop
FILL_POLL_MS=3000
FILL_POLL_TRIES=20
LOOP_SECONDS=0               # 0 = run once; >0 = repeat every N seconds (market hours)
