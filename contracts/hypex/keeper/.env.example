# --- HYPEX keeper config ---

# Keeper wallet (gated to buySpcxd / swapAndBridge; has NO fund-withdraw power).
PRIVATE_KEY=0x...

# HyperEVM RPC + Hyperliquid Info API
RPC_URL=https://rpc.hyperliquid.xyz/evm
HL_API_URL=https://api.hyperliquid.xyz

# Deployed addresses
MANAGER_ADDRESS=0x...                                         # set after deploy
QUOTER_ADDRESS=0x03A918028f22D9E1473B7959C927AD7425A45C7C    # HyperSwap V3 Quoter v2 (verified)

# SPCXD spot book + sizing
SPCXD_BOOK_COIN=@465            # spot pair index 465
SPCXD_SZ_DECIMALS=2            # szDecimals for SPCXD
SLIPPAGE_BPS=100               # 1% tolerance on swaps and the IOC buy
MIN_USDC_CORE=100000000        # don't buy below 1 USDC (core 8-dec) — let it batch

# Fill polling + loop
FILL_POLL_MS=3000
FILL_POLL_TRIES=20
LOOP_SECONDS=0                 # 0 = run once; >0 = repeat every N seconds (market hours)
